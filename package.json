{
  "name": "lark-doc",
  "version": "0.14.4",
  "private": false,
  "license": "MIT",
  "description": "Framework-agnostic LarkDoc-style Tiptap document editor and workspace package",
  "packageManager": "npm@8.19.4",
  "scripts": {
    "build": "ROLLUP_TARGET=core node scripts/build-rollup.mjs",
    "build:esm": "ROLLUP_TARGET=esm node scripts/build-rollup.mjs",
    "build:cjs": "ROLLUP_TARGET=cjs node scripts/build-rollup.mjs",
    "build:adapters": "ROLLUP_TARGET=adapters node scripts/build-rollup.mjs",
    "build:plugin": "ROLLUP_TARGET=plugin node scripts/build-rollup.mjs",
    "build:analyze": "ROLLUP_TARGET=all node scripts/build-rollup.mjs",
    "lint": "eslint --ext .js,.vue src scripts",
    "check": "npm run check:gate && npm run check:artifacts",
    "check:gate": "npm run check:deploy && npm run check:code && npm run check:ui && npm run lint",
    "check:quick": "npm run check:architecture && npm run contract:check && npm run lint",
    "check:code": "npm run check:lark-doc && npm run check:ai && npm run check:architecture && npm run check:unit",
    "check:ui": "npm run check:theme-tokens && npm run check:theme-contrast",
    "check:deploy": "npm run check:node14 && npm run check:offline && npm run check:pkg && node scripts/check-ecs-images.js && node scripts/check-session-providers.js",
    "check:pkg": "node scripts/check-package-exports.js",
    "check:artifacts": "node scripts/ensure-artifacts.mjs && node scripts/check-lite-artifacts.js && node scripts/check-legacy-syntax.js && node scripts/check-vditor-html.js && node scripts/check-rollup-artifacts.mjs --size",
    "check:lite": "node scripts/check-lite-artifacts.js",
    "check:legacy": "node scripts/check-legacy-syntax.js",
    "check:theme-tokens": "node scripts/check-theme-tokens.js",
    "check:theme-contrast": "node scripts/check-theme-contrast.js",
    "check:vditor": "node scripts/check-vditor-html.js",
    "check:lark-doc": "node scripts/check-lark-doc-core.js && node scripts/check-lark-doc-workspace.js",
    "check:ai": "node scripts/check-ai-adapter.js",
    "check:offline": "node scripts/check-offline-assets.js && node scripts/verify-offline-mermaid.mjs",
    "check:node14": "node scripts/check-node14.js",
    "check:architecture": "node scripts/check-architecture.js",
    "check:unit": "vitest run",
    "test:unit": "vitest run test/unit",
    "check:perf": "npm run build:element && node scripts/perf/measure.mjs && node scripts/perf/report.mjs",
    "contract": "node scripts/gen-contract.mjs",
    "contract:check": "node scripts/gen-contract.mjs --check",
    "prepack": "node scripts/ensure-artifacts.mjs && node scripts/check-rollup-artifacts.mjs --size",
    "artifacts:check": "node scripts/ensure-artifacts.mjs --check",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --all",
    "verify:list": "node scripts/verify.mjs --list",
    "build:element": "ROLLUP_TARGET=element node scripts/build-rollup.mjs",
    "build:vue2": "ROLLUP_TARGET=vue2 node scripts/build-rollup.mjs",
    "size": "node scripts/check-rollup-artifacts.mjs --size",
    "ship": "bash scripts/release.sh",
    "ship:minor": "bash scripts/release.sh --minor",
    "sync": "bash scripts/release.sh --git-only",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh --patch",
    "release:minor": "bash scripts/release.sh --minor",
    "build:collab": "ROLLUP_TARGET=collab,collabCjs node scripts/build-rollup.mjs",
    "build:rollup:adapters": "ROLLUP_TARGET=adapters node scripts/build-rollup.mjs",
    "build:rollup:collab": "ROLLUP_TARGET=collab,collabCjs node scripts/build-rollup.mjs",
    "build:rollup": "ROLLUP_TARGET=all node scripts/build-rollup.mjs",
    "check:rollup": "node scripts/check-rollup-artifacts.mjs",
    "build:lite": "ROLLUP_TARGET=lite node scripts/build-rollup.mjs",
    "build:features": "ROLLUP_TARGET=features node scripts/build-rollup.mjs",
    "build:all": "ROLLUP_TARGET=all node scripts/build-rollup.mjs",
    "build:full": "ROLLUP_TARGET=full node scripts/build-rollup.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-file-handler": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-typography": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "core-js": "3.37.1",
    "docx": "8.5.0",
    "emojibase": "15.3.1",
    "highlight.js": "10.7.3",
    "katex": "0.16.47",
    "mammoth": "1.12.1",
    "marked": "4.3.0",
    "turndown": "7.2.2",
    "prosemirror-state": "^1.4.4",
    "prosemirror-model": "^1.25.12",
    "prosemirror-view": "^1.42.6",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-changeset": "^2.4.4"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/preset-env": "7.26.9",
    "@hocuspocus/provider": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "25.0.7",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-terser": "0.4.4",
    "@size-limit/file": "8.2.6",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "babel-eslint": "10.1.0",
    "emojibase-data": "15.3.1",
    "eslint": "7.32.0",
    "eslint-plugin-vue": "8.7.1",
    "jsdom": "^16.7.0",
    "rollup": "3.29.4",
    "rollup-plugin-postcss": "4.0.2",
    "semver": "7.6.3",
    "serialize-javascript": "file:vendor/serialize-javascript-node14",
    "size-limit": "8.2.6",
    "vitest": "^5.0.5",
    "yjs": "13.6.33"
  },
  "engines": {
    "node": ">=14.21.3",
    "npm": ">=8.19.4"
  },
  "overrides": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-bullet-list": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-dropcursor": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-file-handler": "3.32.0",
    "@tiptap/extension-floating-menu": "3.32.0",
    "@tiptap/extension-gapcursor": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-list-item": "3.32.0",
    "@tiptap/extension-list-keymap": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-typography": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lib0": "0.2.119",
    "emojibase": "15.3.1",
    "nanoid": "3.3.18",
    "node-releases": "2.0.20",
    "postcss": "8.5.25",
    "serialize-javascript": "$serialize-javascript",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "turndown": "7.2.2",
    "y-protocols": "1.0.6"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "main": "dist/lark-doc.common.js",
  "module": "dist/lark-doc.esm.js",
  "unpkg": "dist/lark-doc-element.umd.min.js",
  "jsdelivr": "dist/lark-doc-element.umd.min.js",
  "style": "style.css",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "dist/lark-doc.common.js",
    "dist/lark-doc-element.umd.min.js",
    "dist/lark-doc-element.umd.min.*.js",
    "dist/features/*.js",
    "dist/fonts/**",
    "dist/lark-doc-lite.esm.js",
    "dist/lark-doc-full*.js",
    "dist/lark-doc-full*.esm.js",
    "dist/lark-doc-element*.js",
    "src/features/*.js",
    "dist/*polyfills*.js"
  ],
  "files": [
    "dist",
    "src",
    "style.css",
    "README.md",
    "DEMO_INTEGRATION_GUIDE.md",
    "rollup.config.mjs"
  ],
  "exports": {
    ".": {
      "node": "./dist/lark-doc.common.js",
      "import": "./dist/lark-doc.esm.js",
      "require": "./dist/lark-doc.common.js",
      "default": "./dist/lark-doc.common.js"
    },
    "./element": {
      "import": "./dist/lark-doc-element.esm.js",
      "require": "./dist/lark-doc-element.umd.min.js",
      "default": "./dist/lark-doc-element.umd.min.js"
    },
    "./vue2": {
      "node": "./dist/lark-doc-vue2.common.js",
      "import": "./dist/lark-doc-vue2.esm.js",
      "require": "./dist/lark-doc-vue2.common.js",
      "default": "./dist/lark-doc-vue2.common.js"
    },
    "./vue3": {
      "import": "./dist/lark-doc-vue3.mjs",
      "default": "./dist/lark-doc-vue3.mjs"
    },
    "./react": {
      "import": "./dist/lark-doc-react.mjs",
      "default": "./dist/lark-doc-react.mjs"
    },
    "./adapters/vue3": {
      "import": "./dist/lark-doc-vue3.mjs",
      "default": "./dist/lark-doc-vue3.mjs"
    },
    "./adapters/vue2": {
      "node": "./dist/lark-doc-vue2.common.js",
      "import": "./dist/lark-doc-vue2.esm.js",
      "require": "./dist/lark-doc-vue2.common.js",
      "default": "./dist/lark-doc-vue2.common.js"
    },
    "./adapters/react": {
      "import": "./dist/lark-doc-react.mjs",
      "default": "./dist/lark-doc-react.mjs"
    },
    "./templates": {
      "import": "./dist/lark-doc-templates.mjs",
      "default": "./dist/lark-doc-templates.mjs"
    },
    "./comments": {
      "import": "./dist/lark-doc-comments.mjs",
      "default": "./dist/lark-doc-comments.mjs"
    },
    "./versioning": {
      "import": "./dist/lark-doc-versioning.mjs",
      "default": "./dist/lark-doc-versioning.mjs"
    },
    "./providers": {
      "import": "./dist/lark-doc-providers.mjs",
      "default": "./dist/lark-doc-providers.mjs"
    },
    "./migrations": {
      "import": "./dist/lark-doc-migrations.mjs",
      "default": "./dist/lark-doc-migrations.mjs"
    },
    "./collab": {
      "node": "./dist/lark-doc-collab.common.js",
      "import": "./dist/lark-doc-collab.esm.js",
      "require": "./dist/lark-doc-collab.common.js",
      "default": "./dist/lark-doc-collab.common.js"
    },
    "./lite": {
      "import": "./dist/lark-doc-lite.esm.js",
      "default": "./dist/lark-doc-lite.esm.js"
    },
    "./features/*": {
      "import": "./dist/features/*.js",
      "default": "./dist/features/*.js"
    },
    "./plugin": {
      "import": "./dist/plugin.mjs",
      "require": "./dist/plugin.cjs",
      "default": "./dist/plugin.mjs"
    },
    "./style.css": "./dist/lark-doc.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./full": {
      "node": "./dist/lark-doc-full.common.js",
      "import": "./dist/lark-doc-full.esm.js",
      "require": "./dist/lark-doc-full.common.js",
      "default": "./dist/lark-doc-full.common.js"
    },
    "./legacy": {
      "node": "./dist/lark-doc-vue2.common.js",
      "import": "./dist/lark-doc-vue2.esm.js",
      "require": "./dist/lark-doc-vue2.common.js",
      "default": "./dist/lark-doc-vue2.common.js"
    }
  },
  "size-limit": [
    {
      "name": "ESM 主包 (gzip)（编辑器代码，运行时与总初始图另列）",
      "path": "dist/lark-doc.esm.js",
      "limit": "310 KB",
      "gzip": true,
      "scope": "editor"
    },
    {
      "name": "Element 产物 (gzip)",
      "path": "dist/lark-doc-element.umd.min.js",
      "limit": "475 KB",
      "gzip": true
    },
    {
      "path": "dist/lark-doc.common.js",
      "limit": "1080 KB",
      "gzip": true,
      "name": "CJS 主文件（DOM renderer，按需区块已拆出，gzip）"
    },
    {
      "name": "协同子入口 (gzip)",
      "path": "dist/lark-doc-collab.esm.js",
      "limit": "4 KB",
      "gzip": true
    },
    {
      "name": "lite 主包 (gzip)（编辑器代码，运行时与总初始图另列）",
      "path": "dist/lark-doc-lite.esm.js",
      "limit": "300 KB",
      "gzip": true,
      "scope": "editor"
    }
  ],
  "collabDependencies": {
    "@hocuspocus/provider": "^4.7.1",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "yjs": "^13.6.33"
  },
  "browser": {
    "./dist/pm/state.js": "prosemirror-state",
    "./dist/pm/model.js": "prosemirror-model",
    "./dist/pm/view.js": "prosemirror-view",
    "./dist/pm/transform.js": "prosemirror-transform",
    "./dist/pm/commands.js": "prosemirror-commands",
    "./dist/pm/keymap.js": "prosemirror-keymap",
    "./dist/pm/inputrules.js": "prosemirror-inputrules",
    "./dist/pm/schema-list.js": "prosemirror-schema-list",
    "./dist/pm/history.js": "prosemirror-history",
    "./dist/pm/gapcursor.js": "prosemirror-gapcursor",
    "./dist/pm/dropcursor.js": "prosemirror-dropcursor",
    "./dist/pm/tables.js": "prosemirror-tables",
    "./dist/pm/changeset.js": "prosemirror-changeset"
  }
}
