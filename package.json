{
  "name": "lark-doc",
  "version": "0.12.1",
  "private": false,
  "license": "MIT",
  "description": "Vue 2 LarkDoc-style Tiptap document editor and workspace package",
  "packageManager": "npm@8.19.4",
  "scripts": {
    "build": "vue-cli-service build --target lib --no-clean --name lark-doc --formats commonjs src/index.js && node scripts/fix-lib-require-scope.js",
    "build:umd": "LARK_DOC_LEGACY=1 LARK_DOC_TARGET=umd vue-cli-service build --target lib --no-clean --name lark-doc --formats umd-min src/index.js",
    "build:esm": "node scripts/build-esm.js",
    "build:adapters": "node scripts/build-adapters.js",
    "build:analyze": "LARK_DOC_ANALYZE=1 npm run build && LARK_DOC_ANALYZE=1 npm run build:umd && LARK_DOC_ANALYZE=1 npm run build:esm && LARK_DOC_ANALYZE=1 npm run build:element",
    "lint": "eslint --ext .js,.vue src scripts",
    "check": "npm run check:gate && npm run check:artifacts",
    "check:gate": "npm run check:deploy && npm run check:code && npm run check:ui && npm run lint",
    "check:quick": "npm run check:architecture && npm run contract:check && npm run lint",
    "check:code": "npm run check:lark-doc && npm run check:architecture && npm run check:unit",
    "check:ui": "npm run check:theme-tokens && npm run check:theme-contrast",
    "check:deploy": "npm run check:node14 && npm run check:offline && node scripts/check-ecs-images.js && node scripts/check-session-providers.js",
    "check:artifacts": "node scripts/ensure-artifacts.mjs && npm run check:vditor && npm run size",
    "check:theme-tokens": "node scripts/check-theme-tokens.js",
    "check:theme-contrast": "node scripts/check-theme-contrast.js",
    "check:vditor": "node scripts/check-vditor-html.js",
    "check:ai": "node scripts/check-ai-adapter.js",
    "check:lark-doc": "node scripts/check-lark-doc-core.js && node scripts/check-lark-doc-workspace.js && node scripts/check-ai-adapter.js",
    "check:offline": "node scripts/check-offline-assets.js",
    "check:node14": "node scripts/check-node14.js",
    "check:architecture": "node scripts/check-architecture.js",
    "check:unit": "vitest run",
    "test:unit": "vitest run test/unit",
    "check:perf": "npm run build:element && node scripts/perf/measure.mjs && node scripts/perf/report.mjs",
    "contract": "node scripts/gen-contract.mjs",
    "contract:check": "node scripts/gen-contract.mjs --check",
    "prepack": "node scripts/ensure-artifacts.mjs && npm run size",
    "artifacts:check": "node scripts/ensure-artifacts.mjs --check",
    "verify": "node scripts/verify.mjs",
    "verify:all": "node scripts/verify.mjs --all",
    "verify:list": "node scripts/verify.mjs --list",
    "build:element": "LARK_DOC_LEGACY=1 LARK_DOC_TARGET=element vue-cli-service build --target lib --no-clean --inline-vue --name lark-doc-element --formats umd-min src/web-component/index.js",
    "size": "size-limit",
    "ship": "bash scripts/release.sh",
    "ship:minor": "bash scripts/release.sh --minor",
    "sync": "bash scripts/release.sh --git-only",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh --patch",
    "release:minor": "bash scripts/release.sh --minor",
    "build:collab": "node scripts/build-collab.js"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-file-handler": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-typography": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "core-js": "3.37.1",
    "docx": "8.5.0",
    "emojibase": "15.3.1",
    "highlight.js": "10.7.3",
    "katex": "0.16.47",
    "mammoth": "1.12.1",
    "marked": "4.3.0",
    "turndown": "7.2.2"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@size-limit/file": "8.2.6",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/vue-2": "3.32.0",
    "@vue/cli-plugin-babel": "5.0.8",
    "@vue/cli-service": "5.0.8",
    "babel-eslint": "10.1.0",
    "emojibase-data": "15.3.1",
    "eslint": "7.32.0",
    "eslint-plugin-vue": "8.7.1",
    "file-loader": "^6.2.0",
    "jsdom": "^16.7.0",
    "semver": "7.6.3",
    "serialize-javascript": "file:vendor/serialize-javascript-node14",
    "size-limit": "8.2.6",
    "vitest": "^5.0.5",
    "vue": "2.7.14",
    "vue-template-compiler": "2.7.14",
    "yjs": "13.6.33"
  },
  "engines": {
    "node": ">=14.21.3",
    "npm": ">=8.19.4"
  },
  "overrides": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-bullet-list": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-dropcursor": "3.32.0",
    "@tiptap/extension-details": "3.32.0",
    "@tiptap/extension-file-handler": "3.32.0",
    "@tiptap/extension-floating-menu": "3.32.0",
    "@tiptap/extension-gapcursor": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-horizontal-rule": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-list-item": "3.32.0",
    "@tiptap/extension-list-keymap": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-ordered-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-typography": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "lib0": "0.2.119",
    "emojibase": "15.3.1",
    "nanoid": "3.3.18",
    "node-releases": "2.0.20",
    "postcss": "8.5.25",
    "serialize-javascript": "$serialize-javascript",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "turndown": "7.2.2",
    "y-protocols": "1.0.6"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "main": "dist/lark-doc.common.js",
  "module": "dist/lark-doc.esm.js",
  "browser": "dist/lark-doc.umd.min.js",
  "unpkg": "dist/lark-doc.umd.min.js",
  "jsdelivr": "dist/lark-doc.umd.min.js",
  "style": "style.css",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "dist/*"
  ],
  "files": [
    "dist",
    "src",
    "style.css",
    "README.md",
    "DEMO_INTEGRATION_GUIDE.md",
    "babel.config.js",
    "legacy-syntax.js",
    "vue.config.js"
  ],
  "peerDependencies": {
    "@hocuspocus/provider": "^4.7.1",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/vue-2": "^3.32.0",
    "vue": "^2.7.14",
    "yjs": "^13.6.33"
  },
  "peerDependenciesMeta": {
    "@hocuspocus/provider": {
      "optional": true
    },
    "@tiptap/extension-collaboration": {
      "optional": true
    },
    "@tiptap/extension-collaboration-caret": {
      "optional": true
    },
    "@tiptap/vue-2": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "node": "./dist/lark-doc.common.js",
      "import": "./dist/lark-doc.esm.js",
      "require": "./dist/lark-doc.common.js",
      "default": "./dist/lark-doc.common.js"
    },
    "./element": "./dist/lark-doc-element.umd.min.js",
    "./vue3": {
      "import": "./dist/lark-doc-vue3.mjs",
      "default": "./dist/lark-doc-vue3.mjs"
    },
    "./react": {
      "import": "./dist/lark-doc-react.mjs",
      "default": "./dist/lark-doc-react.mjs"
    },
    "./adapters/vue3": {
      "import": "./dist/lark-doc-vue3.mjs",
      "default": "./dist/lark-doc-vue3.mjs"
    },
    "./adapters/react": {
      "import": "./dist/lark-doc-react.mjs",
      "default": "./dist/lark-doc-react.mjs"
    },
    "./collab": {
      "import": "./dist/lark-doc-collab.esm.js",
      "default": "./dist/lark-doc-collab.esm.js"
    },
    "./style.css": "./dist/lark-doc.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "size-limit": [
    {
      "name": "ESM 主包 (gzip)",
      "path": "dist/lark-doc.esm.js",
      "limit": "320 KB",
      "gzip": true
    },
    {
      "name": "UMD 主包 (gzip)",
      "path": "dist/lark-doc.umd.min.js",
      "limit": "505 KB",
      "gzip": true
    },
    {
      "name": "Element 产物 (gzip)",
      "path": "dist/lark-doc-element.umd.min.js",
      "limit": "515 KB",
      "gzip": true
    },
    {
      "name": "CJS 全量产物（内联 mermaid，gzip）",
      "path": "dist/lark-doc.common.js",
      "limit": "2600 KB",
      "gzip": true
    },
    {
      "name": "协同子入口 (gzip)",
      "path": "dist/lark-doc-collab.esm.js",
      "limit": "90 KB",
      "gzip": true
    }
  ]
}
