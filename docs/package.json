{
  "name": "lark-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "lark-doc 开发文档（VitePress，版式对齐 AiEditor Docs）",
  "scripts": {
    "docs:dev": "vitepress dev .",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview .",
    "examples:install": "node ../scripts/demo-build-examples.mjs --install",
    "examples:webpack": "node ../scripts/demo-build-examples.mjs --webpack",
    "examples:vite": "node ../scripts/demo-build-examples.mjs --vite",
    "examples:check": "node ../scripts/demo-build-examples.mjs --check",
    "predocs:build": "node ../scripts/demo-sync-vendor.mjs --check && node ../scripts/demo-build-examples.mjs --check"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
